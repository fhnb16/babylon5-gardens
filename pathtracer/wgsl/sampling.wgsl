// ═══════════════════════════════════════════════════════════════════════════
// sampling.wgsl — integrator sampler and BSDF sampling helpers (pure).
//   • sampler (PT-P4): Owen-scrambled Sobol (Burley 2020) with per-pixel
//     scramble seeds and padded 4-D groups, or the M1 PCG stream; callers only
//     see b5_sampler_start / b5_sampler_bounce / b5_rnd / b5_rnd2.
//     CPU mirror + dimension allocation: pathtracer/sampler.ts.
//       Sobol: the u32 state is the next DIMENSION; the per-path context
//              (pixel seed, sample index) lives in private variables set by
//              b5_sampler_start / _bounce (one path per invocation).
//       PCG:   the u32 state is the PCG state, stored in the path between bounces.
//   • ONB, cosine hemisphere, GGX (D, Smith G1/G2, Schlick F), VNDF sampling
//     (Heitz 2018), power heuristic.
// Mirrored on the CPU by pathtracer/integrator-ref.ts (same formulas).
// Requires common.wgsl (b5_pcg, B5_PI).
// ═══════════════════════════════════════════════════════════════════════════

// dimension allocation (sampler.ts SAMPLER_DIMS): camera 0..3, vertex depth b
// from B5_DIM_BOUNCE0 + b·B5_DIMS_PER_BOUNCE (dir×2, lobe, layer | light pos×2, light pick, RR):
// 2-D samples on components 0, 1 of a 4-D group (the (0, 2)-sequence pair)
const B5_DIM_CAMERA: u32 = 0u;
const B5_DIM_BOUNCE0: u32 = 4u;
const B5_DIMS_PER_BOUNCE: u32 = 8u;
// bits kept of the shuffled index (sampler.ts SOBOL_INDEX_MASK): ≤ 20 loop iterations
const B5_SOBOL_INDEX_MASK: u32 = 0xfffffu;

// Joe–Kuo direction numbers of Sobol dims 1..3 (dim 0 = bit reversal), 32 per
// dim — generated by sampler.ts wgslSobolTable(), checked by sampler.test.ts
const B5_SOBOL_V: array<u32, 96> = array<u32, 96>(
  0x80000000u, 0xc0000000u, 0xa0000000u, 0xf0000000u, 0x88000000u, 0xcc000000u, 0xaa000000u, 0xff000000u,
  0x80800000u, 0xc0c00000u, 0xa0a00000u, 0xf0f00000u, 0x88880000u, 0xcccc0000u, 0xaaaa0000u, 0xffff0000u,
  0x80008000u, 0xc000c000u, 0xa000a000u, 0xf000f000u, 0x88008800u, 0xcc00cc00u, 0xaa00aa00u, 0xff00ff00u,
  0x80808080u, 0xc0c0c0c0u, 0xa0a0a0a0u, 0xf0f0f0f0u, 0x88888888u, 0xccccccccu, 0xaaaaaaaau, 0xffffffffu,
  0x80000000u, 0xc0000000u, 0x60000000u, 0x90000000u, 0xe8000000u, 0x5c000000u, 0x8e000000u, 0xc5000000u,
  0x68800000u, 0x9cc00000u, 0xee600000u, 0x55900000u, 0x80680000u, 0xc09c0000u, 0x60ee0000u, 0x90550000u,
  0xe8808000u, 0x5cc0c000u, 0x8e606000u, 0xc5909000u, 0x6868e800u, 0x9c9c5c00u, 0xeeee8e00u, 0x5555c500u,
  0x8000e880u, 0xc0005cc0u, 0x60008e60u, 0x9000c590u, 0xe8006868u, 0x5c009c9cu, 0x8e00eeeeu, 0xc5005555u,
  0x80000000u, 0xc0000000u, 0x20000000u, 0x50000000u, 0xf8000000u, 0x74000000u, 0xa2000000u, 0x93000000u,
  0xd8800000u, 0x25400000u, 0x59e00000u, 0xe6d00000u, 0x78080000u, 0xb40c0000u, 0x82020000u, 0xc3050000u,
  0x208f8000u, 0x51474000u, 0xfbea2000u, 0x75d93000u, 0xa0858800u, 0x914e5400u, 0xdbe79e00u, 0x25db6d00u,
  0x58800080u, 0xe54000c0u, 0x79e00020u, 0xb6d00050u, 0x800800f8u, 0xc00c0074u, 0x200200a2u, 0x50050093u
);

var<private> b5_smp_sobol: bool = false;
var<private> b5_smp_seed: u32 = 0u;
var<private> b5_smp_index: u32 = 0u;
// per-group cache: the 4 dims of a group share the group seed and the shuffled index
var<private> b5_smp_group: u32 = 0xffffffffu;
var<private> b5_smp_gseed: u32 = 0u;
var<private> b5_smp_shuf: u32 = 0u;

// per-path seed of the PCG stream: pixel index + sample index (+ a frame salt)
fn b5_path_seed(pixel: u32, sample: u32, salt: u32) -> u32 {
  return b5_pcg(pixel ^ b5_pcg(sample ^ b5_pcg(salt)));
}

// per-pixel Owen scramble seed
fn b5_pixel_seed(pixel: u32, salt: u32) -> u32 {
  return b5_pcg(pixel ^ b5_pcg(salt ^ 0x5bd1e995u));
}

fn b5_hash_combine(seed: u32, v: u32) -> u32 {
  return seed ^ (b5_pcg(v) + 0x9e3779b9u + (seed << 6u) + (seed >> 2u));
}

// Laine–Karras-style permutation (Vegdahl 2021): bit k depends on bits ≤ k only
fn b5_lk_permute(xIn: u32, seed: u32) -> u32 {
  var x = xIn;
  x ^= x * 0x3d20adeau;
  x += seed;
  x *= (seed >> 16u) | 1u;
  x ^= x * 0x05526c56u;
  x ^= x * 0x53a22864u;
  return x;
}

fn b5_owen_scramble(x: u32, seed: u32) -> u32 {
  return reverseBits(b5_lk_permute(reverseBits(x), seed));
}

fn b5_sobol_u32(index: u32, comp: u32) -> u32 {
  if (comp == 0u) {
    return reverseBits(index);
  }
  var x = 0u;
  var i = index;
  var b = (comp - 1u) * 32u;
  loop {
    if (i == 0u) {
      break;
    }
    if ((i & 1u) != 0u) {
      x ^= B5_SOBOL_V[b];
    }
    i >>= 1u;
    b += 1u;
  }
  return x;
}

// padded Owen-scrambled Sobol: 4-D groups with shuffled indices
fn b5_sobol_owen(index: u32, dim: u32, seed: u32) -> f32 {
  let gseed = b5_hash_combine(seed, dim >> 2u);
  let comp = dim & 3u;
  let shuffled = b5_owen_scramble(index, gseed) & B5_SOBOL_INDEX_MASK;
  let x = b5_owen_scramble(b5_sobol_u32(shuffled, comp), b5_hash_combine(gseed, comp + 1u));
  return f32(x >> 8u) * (1.0 / 16777216.0);
}

// b5_sobol_owen with the group cache (same values)
fn b5_sobol_owen_cached(dim: u32) -> f32 {
  let g = dim >> 2u;
  if (g != b5_smp_group) {
    b5_smp_group = g;
    b5_smp_gseed = b5_hash_combine(b5_smp_seed, g);
    b5_smp_shuf = b5_owen_scramble(b5_smp_index, b5_smp_gseed) & B5_SOBOL_INDEX_MASK;
  }
  let comp = dim & 3u;
  let x = b5_owen_scramble(b5_sobol_u32(b5_smp_shuf, comp), b5_hash_combine(b5_smp_gseed, comp + 1u));
  return f32(x >> 8u) * (1.0 / 16777216.0);
}

// start a path (k_raygen): returns the state of dimension 0
fn b5_sampler_start(sobol: bool, pixel: u32, sample: u32, salt: u32) -> u32 {
  b5_smp_group = 0xffffffffu;
  b5_smp_sobol = sobol;
  b5_smp_seed = b5_pixel_seed(pixel, salt);
  b5_smp_index = sample;
  if (sobol) {
    return B5_DIM_CAMERA;
  }
  return b5_path_seed(pixel, sample, salt);
}

// resume a path at vertex depth `depth` (k_shade); `stored` = the PCG state kept in the path
fn b5_sampler_bounce(sobol: bool, pixel: u32, sample: u32, salt: u32, depth: u32, stored: u32) -> u32 {
  b5_smp_group = 0xffffffffu;
  b5_smp_sobol = sobol;
  b5_smp_seed = b5_pixel_seed(pixel, salt);
  b5_smp_index = sample;
  if (sobol) {
    return B5_DIM_BOUNCE0 + depth * B5_DIMS_PER_BOUNCE;
  }
  return stored;
}

// next dimension, uniform in [0, 1)
fn b5_rnd(state: ptr<function, u32>) -> f32 {
  if (b5_smp_sobol) {
    let d = *state;
    *state = d + 1u;
    return b5_sobol_owen_cached(d);
  }
  *state = b5_pcg(*state);
  return f32(*state >> 8u) * (1.0 / 16777216.0);
}

fn b5_rnd2(state: ptr<function, u32>) -> vec2f {
  let a = b5_rnd(state);
  let b = b5_rnd(state);
  return vec2f(a, b);
}

// orthonormal basis around unit n (Duff et al. 2017): columns t, b, n
fn b5_onb(n: vec3f) -> mat3x3f {
  let s = select(-1.0, 1.0, n.z >= 0.0);
  let a = -1.0 / (s + n.z);
  let b = n.x * n.y * a;
  let t = vec3f(1.0 + s * n.x * n.x * a, s * b, -s * n.x);
  let bb = vec3f(b, s + n.y * n.y * a, -n.y);
  return mat3x3f(t, bb, n);
}

// cosine-weighted direction in the local frame (z up); pdf = cos / π
fn b5_cosine_local(u: vec2f) -> vec3f {
  let r = sqrt(u.x);
  let phi = 2.0 * B5_PI * u.y;
  return vec3f(r * cos(phi), r * sin(phi), sqrt(max(0.0, 1.0 - u.x)));
}

fn b5_luminance(c: vec3f) -> f32 {
  return dot(c, vec3f(0.2126, 0.7152, 0.0722));
}

fn b5_max3(c: vec3f) -> f32 {
  return max(c.x, max(c.y, c.z));
}

// ─── GGX (isotropic, alpha = roughness²) ────────────────────────────────────

fn b5_ggx_d(nh: f32, a: f32) -> f32 {
  let a2 = a * a;
  let k = nh * nh * (a2 - 1.0) + 1.0;
  return a2 / (B5_PI * k * k);
}

// Smith G1 for the GGX distribution (height-uncorrelated form)
fn b5_ggx_g1(nv: f32, a: f32) -> f32 {
  let a2 = a * a;
  return 2.0 * nv / (nv + sqrt(a2 + (1.0 - a2) * nv * nv));
}

fn b5_schlick(f0: vec3f, c: f32) -> vec3f {
  let m = clamp(1.0 - c, 0.0, 1.0);
  let m2 = m * m;
  return f0 + (vec3f(1.0) - f0) * (m2 * m2 * m);
}

// visible normal in the local frame (z up), Heitz 2018 "Sampling the GGX
// distribution of visible normals"; v = view direction (local, v.z > 0)
fn b5_ggx_vndf_local(v: vec3f, a: f32, u: vec2f) -> vec3f {
  let vh = normalize(vec3f(a * v.x, a * v.y, v.z));
  let lensq = vh.x * vh.x + vh.y * vh.y;
  var t1 = vec3f(1.0, 0.0, 0.0);
  if (lensq > 0.0) {
    t1 = vec3f(-vh.y, vh.x, 0.0) * inverseSqrt(lensq);
  }
  let t2 = cross(vh, t1);
  let r = sqrt(u.x);
  let phi = 2.0 * B5_PI * u.y;
  let p1 = r * cos(phi);
  let s = 0.5 * (1.0 + vh.z);
  let p2 = (1.0 - s) * sqrt(max(0.0, 1.0 - p1 * p1)) + s * r * sin(phi);
  let nh = p1 * t1 + p2 * t2 + sqrt(max(0.0, 1.0 - p1 * p1 - p2 * p2)) * vh;
  return normalize(vec3f(a * nh.x, a * nh.y, max(1e-6, nh.z)));
}

// uniform point on a triangle (area measure): barycentrics (u, v) with
// P = (1 − u − v)·v0 + u·v1 + v·v2
fn b5_tri_uniform(u: vec2f) -> vec2f {
  let su = sqrt(u.x);
  let b0 = 1.0 - su;
  let b1 = u.y * su;
  return vec2f(b1, 1.0 - b0 - b1);
}

// MIS power heuristic (β = 2)
fn b5_power_heuristic(pa: f32, pb: f32) -> f32 {
  let a = pa * pa;
  let b = pb * pb;
  return select(0.0, a / (a + b), a + b > 0.0);
}
